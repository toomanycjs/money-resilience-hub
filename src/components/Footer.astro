---
import { GA_MEASUREMENT_ID } from '../config/analytics';
import { CONTACT_EMAIL, SITE_NAME } from '../config/site';

const year = new Date().getFullYear();
const LINKS = [
	{ href: '/calculators/', label: 'Calculators' },
	{ href: '/salary/', label: 'Salary pages' },
	{ href: '/hourly/', label: 'Hourly pages' },
	{ href: '/monthly/', label: 'Monthly pages' },
	{ href: '/guides/', label: 'Guides' },
	{ href: '/rates/', label: 'Rates and allowances' },
	{ href: '/methodology/', label: 'Methodology' },
	{ href: '/editorial-policy/', label: 'Editorial policy' },
	{ href: '/corrections/', label: 'Corrections' },
	{ href: '/about/', label: 'About' },
	{ href: '/privacy/', label: 'Privacy' },
];
---

<footer class="site-footer">
	<div class="frame">
		<nav aria-label="Site">
			{LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
			{GA_MEASUREMENT_ID && <button type="button" class="link" data-cookie-choices>Cookie choices</button>}
		</nav>
		<p>{SITE_NAME} gives information, not advice. A result tells you what the rules do to a number; it never tells you what to do with your money.</p>
		<p>Every figure comes from a gov.uk page with the date it was checked. Your inputs stay in your browser.</p>
		<p>Contact: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
		<p>&copy; {year} {SITE_NAME}</p>
	</div>
</footer>
