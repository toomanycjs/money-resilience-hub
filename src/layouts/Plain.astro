---
// Long-form pages (methodology, about, privacy, editorial policy) with a
// contents list built from the h2 ids the page passes in.
import Base from './Base.astro';

interface Props {
	title: string;
	description: string;
	h1: string;
	intro?: string;
	contents?: { id: string; label: string }[];
	breadcrumb?: string;
	noindex?: boolean;
	taxYears?: string[];
}
const { title, description, h1, intro, contents = [], breadcrumb, noindex, taxYears } = Astro.props;
---

<Base title={title} description={description} breadcrumb={breadcrumb} noindex={noindex} taxYears={taxYears}>
	<article class="prose">
		<div class="page-head">
			<h1>{h1}</h1>
			{intro && <p class="subtitle">{intro}</p>}
		</div>
		{contents.length > 0 && (
			<nav class="toc" aria-label="Contents">
				<ol>
					{contents.map((c) => <li><a href={`#${c.id}`}>{c.label}</a></li>)}
				</ol>
			</nav>
		)}
		<slot />
	</article>
</Base>
