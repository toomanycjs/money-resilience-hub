---
import { CURRENT_YEAR } from '../../config/site';
import Base from '../../layouts/Base.astro';

const GROUPS = [
	{
		name: 'My pay',
		tools: [
			{ href: '/calculators/take-home-pay/', title: 'Take-home pay calculator', desc: 'Salary to monthly, weekly and daily take-home for England, Northern Ireland, Scotland and Wales, with every student loan plan, three pension types and your tax code.' },
			{ href: '/salary/', title: 'Salary pages', desc: 'A ready-made result for each salary, with a Scottish version, the distance to each threshold and a pension scenario.' },
			{ href: '/calculators/side-hustle-tax/', title: 'Side hustle tax calculator', desc: 'Trading income less expenses or the trading allowance, with income tax and Class 4 National Insurance, this year and under the higher allowance from April 2027.' },
			{ href: '/calculators/pay-rise/', title: 'Pay rise calculator', desc: 'What a rise adds to take-home pay a year and a month, the share of it kept, and any threshold it crosses.' },
			{ href: '/calculators/bonus-tax/', title: 'Bonus tax calculator', desc: 'Income tax, National Insurance and student loan on a one-off bonus, using the monthly thresholds a bonus payslip uses.' },
			{ href: '/calculators/hourly-to-salary/', title: 'Hourly rate to salary calculator', desc: 'An hourly rate, hours a week and weeks a year as an annual salary, with take-home pay a year, a month and a week.' },
			{ href: '/calculators/mileage-allowance/', title: 'Mileage allowance calculator', desc: 'The approved amount for business miles by car, motorcycle or cycle, and the tax relief when an employer pays less.' },
		],
	},
	{
		name: 'My family',
		tools: [
			{ href: '/calculators/child-benefit-charge/', title: 'Child benefit tax charge calculator', desc: 'Child benefit for the year, the High Income Child Benefit Charge on adjusted net income, and what is kept.' },
			{ href: '/calculators/maternity-pay/', title: 'Maternity pay calculator', desc: 'Statutory Maternity Pay week by week and in total from average weekly earnings.' },
			{ href: '/calculators/paternity-pay/', title: 'Paternity pay calculator', desc: 'Statutory Paternity Pay for a week and in total, with the earnings test.' },
		],
	},
	{
		name: 'My savings and property',
		tools: [
			{ href: '/calculators/savings-tax/', title: 'Savings interest tax calculator', desc: 'How much interest is tax free through the personal allowance, the starting rate and the personal savings allowance, and what the rest costs at the savings rates from April 2027.' },
			{ href: '/calculators/landlord-tax/', title: 'Landlord tax calculator', desc: 'Rental profit after expenses or the property allowance, taxed on top of other income, with the property rates that start in April 2027.' },
			{ href: '/calculators/lifetime-isa-penalty/', title: 'Lifetime ISA withdrawal charge calculator', desc: 'The charge on a withdrawal by reason and date, including the reduced charge for a first home over the price cap from 29 October 2026.' },
		],
	},
	{
		name: 'My pension',
		tools: [
			{ href: '/calculators/state-pension-tax/', title: 'State Pension tax calculator', desc: 'Income tax on the State Pension and other pension income, and what the Pension Tax Allowance removes from April 2027.' },
			{ href: '/calculators/pension-contributions/', title: 'Pension contribution calculator', desc: 'The same contribution under relief at source, net pay and salary sacrifice: the cost to take-home pay, tax saved and National Insurance saved.' },
		],
	},
];
---

<Base title="UK tax and pay calculators that show their working" description="Calculators for UK pay and tax that show every deduction with its rate, the slice it applied to and the gov.uk source, grouped by the situation you are in." breadcrumb="Calculators">
	<div class="page-head">
		<h1>Calculators</h1>
		<p class="subtitle">Each result comes with its working and the rules it used, as at {CURRENT_YEAR.label}. More tools are added as each rule is verified against gov.uk and recorded in the rules file.</p>
	</div>
	{GROUPS.map((g) => (
		<section class="calc-section" aria-labelledby={`g-${g.name.replace(/\s+/g, '-').toLowerCase()}`}>
			<h2 id={`g-${g.name.replace(/\s+/g, '-').toLowerCase()}`}>{g.name}</h2>
			<ul class="link-list">
				{g.tools.map((t) => (
					<li>
						<a href={t.href}>{t.title}</a>
						<span class="desc">{t.desc}</span>
					</li>
				))}
			</ul>
		</section>
	))}
	<section class="calc-section">
		<h2>Reference</h2>
		<ul class="link-list">
			<li><a href="/rates/">Rates and allowances by tax year</a><span class="desc">Every figure the calculators use, with its source, the date it was checked and its status.</span></li>
			<li><a href="/budget/2026-autumn/">Budget 2026: what changed</a><span class="desc">The measures from 28 October 2026, their effective dates and worked examples.</span></li>
		</ul>
	</section>
</Base>
