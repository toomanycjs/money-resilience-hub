---
import { longDate } from '@money-resilience-hub/calculators';
import { CURRENT_YEAR } from '../../config/site';
import Base from '../../layouts/Base.astro';
import { LIVE_GUIDES as GUIDES } from '../../lib/guides';

const reviewed = GUIDES.map((g) => g.reviewedOn).sort().at(-1) ?? '';
---

<Base title="Guides to UK pay and tax, with the figures computed" description="Plain explanations of tax codes, payslips, the personal allowance taper, student loan plans, Scottish income tax and the Pension Tax Allowance, with sources." breadcrumb="Guides" taxYears={[CURRENT_YEAR.taxYear]}>
	<div class="page-head">
		<h1>Guides</h1>
		<p class="subtitle">One question each, answered with the number first. Every figure is computed from the rules file as at {CURRENT_YEAR.label}, and every other fact is listed with the gov.uk page it came from. Last reviewed {longDate(reviewed)}.</p>
	</div>
	<section class="calc-section" aria-labelledby="guides-heading">
		<h2 id="guides-heading" class="visually-hidden">All guides</h2>
		<ul class="link-list">
			{GUIDES.map((g) => (
				<li>
					<a href={`/guides/${g.slug}/`}>{g.h1}</a>
					<span class="desc">{g.description}</span>
				</li>
			))}
		</ul>
	</section>
	<section class="calc-section">
		<h2>The tools behind them</h2>
		<ul class="link-list">
			<li><a href="/calculators/">Calculators</a><span class="desc">Each result with its working and the rules it used.</span></li>
			<li><a href={`/rates/${CURRENT_YEAR.taxYear}/`}>Rates and allowances for {CURRENT_YEAR.label}</a><span class="desc">Every figure the guides use, with its source, the date it was checked and its status.</span></li>
		</ul>
	</section>
</Base>
