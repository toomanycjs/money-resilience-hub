    { "source": "/:path*", "has": [{ "type": "host", "value": "moneyresiliencehub.co.uk" }], "destination": "https://www.moneyresiliencehub.co.uk/:path*", "permanent": true },
    { "source": "/salary/20k/", "destination": "/salary/20000/", "permanent": true },
